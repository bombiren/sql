GROUP BY:
SELECT MIN(placa_pod + COALESCE(placa_dod, 0)) AS najnizsza, MAX(placa_pod + COALESCE(placa_dod, 0)) AS najwyzsza, MAX(placa_pod + COALESCE(placa_dod, 0)) - MIN(placa_pod + COALESCE(placa_dod, 0)) AS roznica FROM `pracownicy`;
SELECT etat, AVG(placa_pod + COALESCE(placa_dod, 0)) AS srednia FROM `pracownicy` GROUP BY etat ORDER BY srednia;
SELECT COUNT(*) FROM `pracownicy` WHERE etat = 'Profesor';
SELECT id_zesp, SUM(placa_pod + COALESCE(placa_dod, 0)) AS suma_plac FROM `pracownicy` GROUP BY id_zesp;
SELECT id_zesp, COUNT(*) AS liczba_pracownikow FROM `pracownicy` WHERE id_zesp IS NOT NULL GROUP BY id_zesp HAVING COUNT(*) > 2 ORDER BY liczba_pracownikow DESC;
SELECT etat, AVG(placa_pod + COALESCE(placa_dod, 0)) AS srednia, COUNT(*) AS liczba FROM `pracownicy` WHERE zatrudniony <= '1990-12-31' GROUP BY etat;
SELECT id_prac, COUNT(*) FROM `pracownicy` GROUP BY id_prac HAVING COUNT(*) >1;
SELECT etat, AVG(placa_pod + COALESCE(placa_dod, 0)) AS srednia FROM `pracownicy` GROUP BY etat;
SELECT etat, MIN(placa_pod + COALESCE(placa_dod, 0)) AS minimalna, MAX(placa_pod + COALESCE(placa_dod, 0)) AS maksymalna, AVG(placa_pod + COALESCE(placa_dod, 0)) AS srednia  FROM `pracownicy` GROUP BY etat ORDER BY srednia DESC;
SELECT etat, MIN(placa_pod + COALESCE(placa_dod, 0)) AS minimalna, MAX(placa_pod + COALESCE(placa_dod, 0)) AS maksymalna, AVG(placa_pod + COALESCE(placa_dod, 0)) AS srednia  FROM `pracownicy` GROUP BY etat ORDER BY srednia ASC;

