GROUP BY:
SELECT MIN(placa), MAX(placa), MAX(placa)-MIN(placa) FROM pracownicy;
SELECT etat, AVG(placa) FROM pracownicy GROUP BY etat ORDER BY AVG(placa) DESC;
SELECT COUNT(*) FROM pracownicy WHERE etat='PROFESOR';
SELECT id_zesp, SUM(placa+COALESCE(placa_dod,0)) FROM pracownicy WHERE id_zesp IS NOT NULL GROUP BY id_zesp;
SELECT id_zesp, COUNT(*) FROM pracownicy WHERE id_zesp IS NOT NULL GROUP BY id_zesp HAVING COUNT(*)>2 ORDER BY COUNT(*) DESC;
SELECT etat, AVG(placa), COUNT(*) FROM pracownicy WHERE zatrudniony<='1990-12-31' GROUP BY etat;
SELECT id_prac, COUNT(*) FROM pracownicy GROUP BY id_prac HAVING COUNT(*)>1;
SELECT stanowisko, AVG(placa) FROM pracownicy GROUP BY stanowisko;
SELECT stanowisko, AVG(placa) FROM pracownicy GROUP BY stanowisko ORDER BY AVG(placa) DESC;
SELECT stanowisko, MIN(placa), MAX(placa), AVG(placa) FROM pracownicy GROUP BY stanowisko ORDER BY stanowisko ASC;
SELECT stanowisko, COUNT(*) FROM pracownicy GROUP BY stanowisko;
SELECT stanowisko, AVG(placa) FROM pracownicy GROUP BY stanowisko HAVING AVG(placa)>1400;
SELECT etat, COUNT(*) FROM pracownicy GROUP BY etat HAVING COUNT(*)=(SELECT MAX(liczba) FROM (SELECT COUNT(*) AS liczba FROM pracownicy GROUP BY etat) t);
SELECT id_zesp, AVG(placa) FROM pracownicy WHERE id_zesp IS NOT NULL GROUP BY id_zesp;
SELECT etat, MAX(placa) FROM pracownicy GROUP BY etat;
SELECT EXTRACT(YEAR FROM zatrudniony), COUNT(*) FROM pracownicy GROUP BY EXTRACT(YEAR FROM zatrudniony);
SELECT * FROM pracownicy WHERE placa=(SELECT MIN(placa) FROM pracownicy);
SELECT * FROM pracownicy WHERE nazwisko LIKE 'K%';
SELECT * FROM pracownicy WHERE placa>3000;
SELECT * FROM pracownicy WHERE zatrudniony>'2022-12-31';
SELECT * FROM pracownicy WHERE LOWER(nazwisko) LIKE '%a%';
SELECT * FROM pracownicy WHERE nazwisko LIKE 'K%i';
SELECT z.nazwa FROM zespoly z JOIN pracownicy p ON p.id_zesp=z.id_zesp GROUP BY z.id_zesp,z.nazwa HAVING COUNT(*)>3;
SELECT * FROM pracownicy WHERE placa=(SELECT MIN(placa) FROM pracownicy);
SELECT z.nazwa,COUNT(*) FROM zespoly z JOIN pracownicy p ON p.id_zesp=z.id_zesp GROUP BY z.id_zesp,z.nazwa HAVING COUNT(*)=(SELECT MAX(liczba) FROM (SELECT COUNT(*) AS liczba FROM pracownicy WHERE id_zesp IS NOT NULL GROUP BY id_zesp) t);
